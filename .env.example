# SANITIZED CONFIGURATION TEMPLATE ? no real passwords, keys or database identities.
# This file is documentation, not a loaded Next.js environment file.
# Hostinger: enter values in the application runtime environment. Local/staging:
# use a private .env.local with an ISOLATED database and approved test mailboxes.
# Never commit .env.local, copy production secrets here, or add NEXT_PUBLIC_ to secrets.
# The five feature flags below must remain false until separately approved.

# Public URL: example only. Production's intended value is https://techromzit.com.
# Set before BUILD and at runtime: public URL/SEO metadata can be generated at build.
NEXT_PUBLIC_APP_URL=https://institute.example.com
# Exact false enables legacy Retail routing. Institute-only defaults on.
# Configure consistently at BUILD and runtime; changing rewrites needs a rebuild.
INSTITUTE_ONLY_MODE=true
# Exact true requests indexing; default false. Needs an approved HTTPS public origin.
INSTITUTE_ALLOW_INDEXING=false

# Exact lowercase true is the ONLY value that activates each feature.
# Missing, empty, false, TRUE, 1 and yes all leave these disabled.
INSTITUTE_COURSE_ENQUIRY_ENABLED=false
INSTITUTE_ADMIN_ENABLED=false
INSTITUTE_REGISTRATION_ENABLED=false
INSTITUTE_PAYMENT_ENABLED=false
INSTITUTE_SEAT_AVAILABILITY_ENABLED=false

# Public write/certificate guards: exact accepted mode shown below.
# Other/missing modes fail closed. All six existing migrations must be checked;
# do not rerun already applied migrations merely to configure the application.
INSTITUTE_ABUSE_PROTECTION_MODE=identifier-and-global
# Comma-separated exact hostnames, no scheme, port, path or wildcard.
# Example only: replace with approved deployment hosts (including staging hosts).
INSTITUTE_ALLOWED_HOSTS=institute.example.com

# Three DIFFERENT base64-encoded 32-byte secrets, supplied server-side at runtime.
# Generate securely for a new isolated environment. Preserve existing production keys;
# replacing them can make encrypted records unreadable or invalidate lookups/sessions.
INSTITUTE_SESSION_HASH_KEY=
INSTITUTE_PII_LOOKUP_KEY=
INSTITUTE_PII_ENCRYPTION_KEY=

# Required server-only MariaDB/MySQL settings: leave identity/credentials blank here.
INSTITUTE_DB_HOST=
INSTITUTE_DB_PORT=3306
INSTITUTE_DB_NAME=
INSTITUTE_DB_USER=
INSTITUTE_DB_PASSWORD=
# Optional integer 1..20; omitted/empty defaults to 5. Queue limit is 50.
INSTITUTE_DB_CONNECTION_LIMIT=5
# true/false (app reader is case-insensitive); omitted/empty defaults false.
# Confirm TLS requirements with Hostinger. true retains certificate validation.
INSTITUTE_DB_SSL=false

# Shared runtime SMTP configuration for OTP and enquiry notification delivery.
# Current source supports smtp.hostinger.com:465 with implicit TLS only;
# this public endpoint is not a credential. Confirm it against the hosting account.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
# Fill with the approved authenticated mailbox and credential in private runtime settings.
SMTP_USER=
SMTP_PASS=
# Must match SMTP_USER. Do not use a student's address as From.
SMTP_FROM_EMAIL=
# Notification destination is fixed by source to enrolments@techromzit.com.
# Blank/omitted uses that destination; no alternate recipient is supported.
ENQUIRY_RECIPIENT_EMAIL=

# Legacy SMTP names remain supported. These lines are COMMENTS, not empty overrides.
# Use one complete naming scheme. If both are present, paired values must match
# exactly; conflicts fail closed without logging their values. Primary SMTP_*
# has nullish precedence; an explicitly empty primary value does not fall back.
# INSTITUTE_SMTP_HOST=smtp.hostinger.com
# INSTITUTE_SMTP_PORT=465
# INSTITUTE_SMTP_SECURE=true
# INSTITUTE_SMTP_USER=
# INSTITUTE_SMTP_PASSWORD=
# INSTITUTE_SMTP_FROM=

# Runtime integer policies. Missing uses defaults; configured blank/invalid fails closed.
OTP_EXPIRY_MINUTES=5
# Accepted 1..10 minutes.
OTP_MAX_ATTEMPTS=5
# Accepted 1..5 attempts.
OTP_RESEND_COOLDOWN_SECONDS=60
# Accepted 60..900 seconds; persistent identifier/global/mailbox limits also apply.

# Required before enabling course enquiries or the scheduled delivery worker.
# Generate 32..256 random visible ASCII characters WITHOUT whitespace (64 hex
# characters or a securely generated base64url value are suitable formats).
# Empty is intentionally unusable. Never use a literal example as the secret.
INSTITUTE_ENQUIRY_WORKER_SECRET=
# Cron must POST /api/institute/course-enquiries/delivery over public HTTPS
# using Authorization: Bearer <worker-secret>. Never put it in a URL or client code.
# This setting alone does not schedule the worker or prove email delivery.

# OPTIONAL supplementary IP hint; historical variable name retained for compatibility.
# Hostinger recommends X-Real-IP on CDN traffic, but direct-origin isolation and
# authenticated proxy identity are NOT established on this hosting configuration.
# A configured header is UNVERIFIED, never an authentication/primary-limit key.
# No automatic fallback, forwarded-chain splitting, CDN range allowlist or trust proof.
# Empty/missing/invalid hints skip only supplementary IP limits. Required hashed
# email/session/global database limits still run first and fail closed on errors.
# This example does not change Hostinger settings or prove CDN traversal.
INSTITUTE_TRUSTED_CLIENT_IP_HEADER=X-Real-IP

# Optional operator-only certificate failure codes. Only exact true enables logs;
# unset/false defaults off. No raw headers, tokens or PII are logged by this switch.
INSTITUTE_SECURITY_DIAGNOSTICS=false

# OPTIONAL development/build/legacy settings ? not required for Institute enquiry.
# Development-only allowed hostname list for Next dev; never a proxy trust setting.
INSTITUTE_DEV_ALLOWED_ORIGINS=
# Optional alternate build directory; leave unset for normal .next.
# NEXT_DIST_DIR=.next
# NODE_ENV is managed by Next.js/hosting; do not set development in production.
NEXT_PUBLIC_API_BASE_URL=/api
# Legacy browser API alias; primary API_BASE_URL wins.
NEXT_PUBLIC_API_URL=/api
# Legacy server rewrite target used only when INSTITUTE_ONLY_MODE=false.
BACKEND_API_URL=http://localhost:8000/api
NEXT_PUBLIC_AUTH_COOKIE=_el_tok
NEXT_PUBLIC_USE_ADMIN_MOCKS=false
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=

# TEST/OPERATOR CLI ONLY ? do not configure these to enable a production workflow.
# INSTITUTE_MARIADB_INTEGRATION=false
# INSTITUTE_TEST_DATABASE_NAME=  # Must explicitly match an isolated test database.
# INSTITUTE_READ_ONLY_DIAGNOSTIC=false
# INSTITUTE_COURSE_ENQUIRY_LOCAL_TEST_MODE=false
# The last setting belongs to a disconnected local fixture, not real DB/SMTP delivery.
