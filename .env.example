# Laravel Backend API
NEXT_PUBLIC_API_BASE_URL=/api

# Legacy fallback kept for older branches only. Prefer NEXT_PUBLIC_API_BASE_URL.
NEXT_PUBLIC_API_URL=/api

# Laravel URL as seen by the Next.js server (never sent to the browser).
BACKEND_API_URL=http://localhost:8000/api

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only deployment selector. Institute-only mode is the default for this
# repository; set false only when intentionally running the legacy Retail app.
INSTITUTE_ONLY_MODE=true

# Launch-only SEO switch. Keep false for development and staging. Production indexing
# activates only when INSTITUTE_ONLY_MODE=true and NEXT_PUBLIC_APP_URL is a valid HTTPS
# production origin (never localhost). Review robots.txt and sitemap.xml before enabling.
INSTITUTE_ALLOW_INDEXING=false

# Server-only Institute MySQL/MariaDB connection. Configure these in Hostinger
# runtime environment variables. Never prefix database values with NEXT_PUBLIC_.
INSTITUTE_DB_HOST=
INSTITUTE_DB_PORT=3306
INSTITUTE_DB_NAME=
INSTITUTE_DB_USER=
INSTITUTE_DB_PASSWORD=
INSTITUTE_DB_CONNECTION_LIMIT=5
INSTITUTE_DB_SSL=false

# Institute Phase 2 controls. Keep false until migrations, TLS, administrator
# provisioning, backups and production runtime validation are complete.
INSTITUTE_ADMIN_ENABLED=false
INSTITUTE_REGISTRATION_ENABLED=false
INSTITUTE_PAYMENT_ENABLED=false
INSTITUTE_SEAT_AVAILABILITY_ENABLED=false
# Independent public enquiry workflow. Keep false until migration 005, the
# dedicated staging database, contact verification and SMTP are validated.
INSTITUTE_COURSE_ENQUIRY_ENABLED=false
# Explicit development-only simulation. Uses memory for OTPs/enquiries and never sends email.
INSTITUTE_COURSE_ENQUIRY_LOCAL_TEST_MODE=false
INSTITUTE_DEV_ALLOWED_ORIGINS=

# Base64-encoded 32-byte secrets, server-side only. Generate separately in the
# production secret manager; never prefix these values with NEXT_PUBLIC_.
INSTITUTE_PII_ENCRYPTION_KEY=
INSTITUTE_PII_LOOKUP_KEY=
INSTITUTE_SESSION_HASH_KEY=

# IP-independent abuse protection. Keep disabled until migration 004, hostname
# validation and staging tests are complete. Never trust forwarded IP headers.
# Required for course enquiries and other public write endpoints after the
# Institute database migrations and staging proxy validation are complete.
INSTITUTE_ABUSE_PROTECTION_MODE=identifier-and-global
INSTITUTE_ALLOWED_HOSTS=techromzit.com,www.techromzit.com

# Hostinger SMTP email verification. Server-side only; never use NEXT_PUBLIC_.
# Keep registration disabled until these values have been tested in staging.
INSTITUTE_SMTP_HOST=smtp.hostinger.com
INSTITUTE_SMTP_PORT=465
INSTITUTE_SMTP_USER=enrolments@techromzit.com
INSTITUTE_SMTP_PASSWORD=
INSTITUTE_SMTP_FROM=enrolments@techromzit.com
INSTITUTE_SMTP_SECURE=true

# Server-only recipient for course enquiry notifications.
ADMIN_EMAIL=sriyanf@techromz.lk

# Auth cookie name (WAF-safe, no standard field names)
NEXT_PUBLIC_AUTH_COOKIE=_el_tok

# Optional: Pusher / real-time messaging
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=
