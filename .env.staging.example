# Sanitized template only. Supply isolated resources in a private staging file.
NEXT_PUBLIC_APP_URL=https://staging.example.com
INSTITUTE_ALLOWED_HOSTS=staging.example.com
INSTITUTE_ONLY_MODE=true
INSTITUTE_ALLOW_INDEXING=false
INSTITUTE_ABUSE_PROTECTION_MODE=identifier-and-global
INSTITUTE_COURSE_ENQUIRY_ENABLED=false
INSTITUTE_ADMIN_ENABLED=false
INSTITUTE_REGISTRATION_ENABLED=false
INSTITUTE_PAYMENT_ENABLED=false
INSTITUTE_SEAT_AVAILABILITY_ENABLED=false
INSTITUTE_DB_HOST=
INSTITUTE_DB_PORT=3306
INSTITUTE_DB_NAME=
INSTITUTE_TEST_DATABASE_NAME=
INSTITUTE_DB_USER=
INSTITUTE_DB_PASSWORD=
INSTITUTE_DB_SSL=true
INSTITUTE_SESSION_HASH_KEY=
INSTITUTE_PII_LOOKUP_KEY=
INSTITUTE_PII_ENCRYPTION_KEY=
INSTITUTE_ENQUIRY_WORKER_SECRET=
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
ENQUIRY_RECIPIENT_EMAIL=enrolments@techromzit.com
INSTITUTE_STAGING_TEST_EMAIL=
INSTITUTE_STAGING_APPROVED_RECIPIENTS=
